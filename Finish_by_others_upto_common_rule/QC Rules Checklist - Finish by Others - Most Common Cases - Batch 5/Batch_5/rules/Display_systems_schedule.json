{
    "rule_id": "RULE_NOTE_DISPLAY_SYSTEMS_SCHEDULE_BY_OTHERS_001",
    "rule_name": "Display Systems Schedule By Others Note Validation",
    "common_rule_group": "display_systems_schedule",
    "type_of_rule": "note_validation",
    "category": "Notes Check",
    "discipline": "Millwork",
    "required_sources": [
        "Submittal Drawing",
        "Architectural Drawing"
    ],
    "validation_flow": "arch_vs_submittal_v1",
    "view_applicability": {
        "allowed_view_types": [],
        "view_matching_logic": "Validate this rule only if the current view is an Elevation where Schedule are represented."
    },
    "arch_reference": {
        "required": true
    },
    "scope_identification": {
        "method": "schedule_based",
        "schedule_name": "Schedule",
        "match_field": "code / tag",
        "resolution": "The active code_tag and description are pulled at runtime from schedule.json, filtered where common_rule_group == 'display_systems_schedule'. No keywords are hardcoded in this rule."
    },
    "arch_scope_validation": {
        "match_type": "intersection",
        "description": "Compare the active_code_tag (resolved from schedule.json) with the visible tags extracted from the corresponding architectural view. If the active_code_tag is visible in the arch view, arch scope is applicable."
    },
    "note_template": {
        "expected_notes_pattern": [
            "{DESCRIPTION} BY OTHERS",
            "{DESCRIPTION} B.O.",
            "PROVIDE {DESCRIPTION} BY OTHERS",
            "{TAG} BY OTHERS",
            "{TAG} B.O.",
            "{TAG}"
        ],
        "match_type": "semantic",
        "description": "{DESCRIPTION} placeholder is filled at runtime using the matched schedule.json row's 'description' field (e.g. 'COFFEE GRINDER')."
    },
    "submittal_validation": {
        "validation_type": "note_presence",
        "anchoring": {
            "required": true,
            "method": "tag_proximity",
            "description": "Because multiple display systems-category items can appear on the same submittal sheet, the extracted note must be spatially anchored to the active_code_tag's callout/bubble before running semantic match. A note belonging to a different tag (e.g. E-10 note found while validating E-11) must NOT be matched."
        },
        "match_type": "semantic",
        "notes_source": "note_template.expected_notes_pattern resolved with active_description"
    },
    "decision_logic": {
        "arch_found_submittal_found": "PASS",
        "arch_found_submittal_not_found": "FAIL",
        "arch_not_found_submittal_found": "REVIEW_REQUIRED",
        "arch_not_found_submittal_not_found": "OMITTED"
    },
    "execution_flow": {
        "check_view_applicability": true,
        "check_arch_scope": true,
        "check_submittal": true
    },
    "confidence_score": {
        "minimum_pass_threshold": 75.0
    },
    "markup": {
        "enabled": true,
        "statuses": [
            "FAIL",
            "REVIEW_REQUIRED"
        ]
    },
    "severity": "Major",
    "priority": "High",
    "output_required": {
        "confidence_score": true,
        "reasoning": true,
        "coordinates": true,
        "detected_text": true
    },
    "output_json_format": {
        "rule_id": "string",
        "rule_name": "string",
        "common_rule_group": "string",
        "active_code_tag": "string",
        "active_description": "string",
        "sheet_status": "PASS | FAIL | REVIEW_REQUIRED | OMITTED",
        "drawing_context": {
            "arch_reference": "string",
            "architectural_view_name": "string",
            "submittal_view_name": "string"
        },
        "view_results": [
            {
                "view_id": "string",
                "view_type": "string",
                "view_applicable": "boolean",
                "arch_scope_applicable": "boolean",
                "active_code_tag": "string",
                "validation_result": {
                    "arch_scope_found": "boolean",
                    "submittal_note_found": "boolean"
                },
                "status": "PASS | FAIL | REVIEW_REQUIRED | OMITTED",
                "confidence_score": "float",
                "reasoning": "string",
                "detected_entities": [
                    {
                        "entity_name": "string",
                        "detected_text": "string",
                        "coordinates": {
                            "left": 0,
                            "top": 0,
                            "right": 0,
                            "bottom": 0
                        }
                    }
                ]
            }
        ],
        "markup_required": "boolean",
        "severity": "Minor | Major | Critical",
        "priority": "Low | Medium | High"
    }
}