        "match_field": "code / tag",
        "resolution": "The active code_tag, description, and views_to_check are pulled at runtime from schedule.json. No keywords are hardcoded."
    },
    "geometry_logic": {
        "boundary_detection": "Look carefully for any graphic representing a sink, basin, or faucet. In architectural CAD drawings, these fixtures do not have a fixed shape and can be drawn in countless abstract styles and variations. They may be extremely thin, faint, or schematic. Look for any geometric block, outline, or symbol that contextually represents a plumbing fixture. Do not expect a realistic image. Ignore all text, dimension arrows, and circular tags, and focus purely on finding the CAD representation of the fixture, no matter how it is drawn."
    },
    "note_template": {
        "expected_notes_pattern": [
            "{DESCRIPTION} BY OTHERS",
            "{DESCRIPTION} B.O.",
            "{DESCRIPTION} SINK & FAUCET BY OTHERS, TYP.",
            "{TAG} SINK AND FAUCET BY OTHERS",
            "{TAG} SINK & FAUCET BY OTHERS",
            "{TAG} SINK AND FAUCET BY OTHERS TYP."
        ],
        "match_type": "semantic",
        "description": "{DESCRIPTION} and {TAG} placeholders are filled at runtime using the matched schedule.json row."
